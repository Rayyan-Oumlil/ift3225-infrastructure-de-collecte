PORT=3000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ift3225

# Secret utilisé pour signer les JWT des comptes usagers (générer une valeur aléatoire, ne jamais commiter la vraie valeur)
JWT_SECRET=<une-longue-chaine-aleatoire>

# Bridge Phyphox pour collecte en temps réel (requis pour npm run bridge)
PHYPHOX_IP=192.168.x.x
# Port du serveur Phyphox (défaut : 80, souvent 80)
PHYPHOX_PORT=80
API_KEY=<votre-cle-api-obtenue-via-POST-/devices>
SERVER_URL=http://localhost:3000
LOCATION=cafe-brunch
